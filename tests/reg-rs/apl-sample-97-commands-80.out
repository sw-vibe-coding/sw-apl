      )DEF Z←SUM M
[1]   Z←gROWS gROWS M
[2]   
      )DEF Z←GEN M;S
[1]   S←SUM M
[2]   Z←(S=3)vM&S=4
[3]   
      )DEF RUN N
[1]   ' *'(1+G)
[2]   G←GEN G
[3]   N←N_1
[4]   →(N>0)/1
