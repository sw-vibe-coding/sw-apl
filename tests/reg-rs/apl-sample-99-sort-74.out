0001  @RUN   ALBANY,76104,CS301,1,20
0002  @APL,I
UNIVERSITY OF MARYLAND APL
CLEAR WS
0003  $CM SORTING: NUMBERS UP AND DOWN, THEN NAMES INTO ALPHABETICAL ORDER
      ⍝ SORTING: NUMBERS UP AND DOWN, THEN NAMES INTO ALPHABETICAL ORDER
0004  V $AL 31 4 15 92 65 35 89 79
      V ← 31 4 15 92 65 35 89 79
0005  V$LB$GU V$RB
      V[⍋ V]
4 15 31 35 65 79 89 92
0006  V$LB$GD V$RB
      V[⍒ V]
92 89 79 65 35 31 15 4
0007  $CM THE NAMES, A ROW EACH, BLANKS AFTER
      ⍝ THE NAMES, A ROW EACH, BLANKS AFTER
0008  W $AL 5 6$RH'SMITH JONES ADAMS BAKER ADAIR '
      W ← 5 6⍴'SMITH JONES ADAMS BAKER ADAIR '
0009  W
      W
SMITH 
JONES 
ADAMS 
BAKER 
ADAIR 
0010  $CM EACH LETTER'S PLACE IN THE ALPHABET, AND A ROW READ AS ONE NUMBER
      ⍝ EACH LETTER'S PLACE IN THE ALPHABET, AND A ROW READ AS ONE NUMBER
0011  A $AL ' ABCDEFGHIJKLMNOPQRSTUVWXYZ'
      A ← ' ABCDEFGHIJKLMNOPQRSTUVWXYZ'
0012  K $AL 27$DC$TR A$IO W
      K ← 27⊥⍉ A⍳ W
0013  W$LB$GU K;$RB
      W[⍋ K;]
ADAIR 
ADAMS 
BAKER 
JONES 
SMITH 
0014  @FIN
END OF RUN
