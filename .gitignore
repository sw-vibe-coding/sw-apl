/target/
/dist/
# Each components/<name>/ is its own cargo workspace; .cargo/config.toml
# points them all at the shared /target/ above, but guard the local
# trees anyway.
/components/*/target/
# trunk dev build output for the future web app.
/components/web/dist/

# The browser demo's WebAssembly, built into pages/ by `just pages`.
# The page, the worker and the service worker beside it are source and
# are tracked; only the build output is not. Publishing to GitHub Pages
# needs these files served from somewhere, so whoever configures it
# decides: commit this directory, or build it in a workflow.
/pages/wasm/

# Copied into the bundle by `just pages` from images/redistributed/,
# which is where the tracked original and its licence live.
/pages/redistributed/

# Claude Code local state: per-machine settings + runtime locks.
# EXCEPTION: .claude/commands/ holds shared slash commands (e.g.
# /mw-cp) that must travel with the repo.
.claude/*
!.claude/commands/

# macOS Finder metadata
.DS_Store
**/.DS_Store

# agentrail raw session transcripts: huge append-only event logs.
# NOT part of the durable saga handoff (steps/, trajectories/,
# plan.md, saga.toml stay tracked). Kept locally, never committed.
.agentrail/sessions/
.agentrail-archive/*/sessions/

# Workspaces are tracked or not by who wrote them, not by what they
# are: they are small UTF-8 text, so size is no reason either way.
#
#   ws/    tracked -- the library workspaces sw-apl ships, which are
#          ours, each carrying a DESCRIBE function.
#   work/  ignored -- library 0, where )SAVE writes, and where
#          anything converted from elsewhere belongs. See its README.
#
# Material we do not own goes in work/ and nowhere else, so that it
# cannot be redistributed by accident.

# reg-rs keeps the .rgt spec and .out baseline under version control;
# the SQLite run database and its lock are per-machine state.
tests/reg-rs/*.tdb
tests/reg-rs/*.tdb.lock

# Scratch: saved workspaces and material converted for local use.
# See work/README.md -- nothing in here is part of sw-apl.
#
# Anchored to the repository root: it is THIS library 0 that is
# scratch, not every directory named work. tests/scripts/work/ is a
# fixture library our own binary wrote, and it is tracked.
/work/
